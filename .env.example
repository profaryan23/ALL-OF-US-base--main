# Documentation only: the app does not automatically load .env files.
# Set these in Render's Environment tab or your shell.
APP_ENV=production
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
COOKIE_SECURE=true
PRODUCT_IMAGE_DIR=/var/data/product-images